<% content_for :title, "Новый пароль" %>

<main class="auth-page">
  <section class="auth-card">
    <h1 class="auth-card__title">Новый пароль</h1>

    <% if flash[:alert] %>
      <p class="auth-flash auth-flash--alert" role="alert"><%= flash[:alert] %></p>
    <% end %>

    <%= form_with url: password_path(params[:token]), method: :put, class: "auth-form" do |form| %>
      <div class="auth-form__field">
        <%= form.label :password, "Пароль" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>
      <div class="auth-form__field">
        <%= form.label :password_confirmation, "Повтор пароля" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>
      <%= form.submit "Сохранить", class: "btn btn--primary auth-form__submit" %>
    <% end %>
  </section>
</main>
