<% content_for :title, "#{t('pages.useful.title')} - Казан-нуры" %>
<% content_for :description, t("pages.useful.meta_description") %>

<%= render "shared/topbar", links: link_to(t("pages.back_home"), root_path) %>
<%= render "shared/site_header", solid: true, active: :useful, show_donate: true %>

<%= render "shared/page_hero",
      kicker: t("pages.useful.kicker"),
      title: t("pages.useful.title"),
      lead: t("pages.useful.lead"),
      jump_links: [
        { label: t("pages.useful.jump.faq"), href: "#faq" },
        { label: t("pages.useful.jump.dua"), href: "#dua" },
        { label: t("pages.useful.jump.videos"), href: "#useful-videos" }
      ] %>

<div class="useful-page">
  <section class="useful-section" id="faq">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Вопросы и ответы</span>
        <h2>О жизненных обрядах</h2>
        <p class="muted"><%= t("pages.useful.faq_lead") %></p>
      </div>

      <div class="useful-faq">
        <% @faq_sections.each do |section| %>
          <%= render "shared/faq_accordion", section: section %>
        <% end %>
      </div>
    </div>
  </section>

  <%= render "shared/useful_video_section",
        id: "dua",
        kicker: t("pages.useful.dua_kicker"),
        title: t("pages.useful.dua_title"),
        lead: t("pages.useful.dua_lead"),
        videos: @dua_videos,
        empty_message: t("pages.useful.dua_empty"),
        alt: true,
        gold_kicker: true %>

  <%= render "shared/useful_video_section",
        id: "useful-videos",
        kicker: t("pages.useful.clips_kicker"),
        title: t("pages.useful.clips_title"),
        lead: t("pages.useful.clips_lead"),
        videos: @useful_videos,
        empty_message: t("pages.useful.clips_empty") %>
</div>

<% if @show_video_modal %>
  <%= render "pages/video_modal" %>
<% end %>

<%= render "shared/site_footer" %>
